cff-version: 1.2.0
message: "If you use these notebooks or reports, please cite the underlying datasets."
title: "Harpd AI Research Notebooks"
abstract: >-
  Reproducible Jupyter notebooks and generated reports that compute findings
  from the Harpd open AI datasets. Every figure is produced by pandas operations
  over published data; no value is estimated or generated by a language model.
type: software
authors:
  - name: "Harpd"
    website: "https://harpd.com"
repository-code: "https://github.com/harpd-dev/harpd-ai-research-notebooks"
url: "https://harpd.com/data/"
license: CC-BY-4.0
version: "1.0.0"
date-released: "2026-09-16"
keywords:
  - ai
  - research
  - dataset
  - open-data
  - reproducible-research
  - jupyter-notebooks
  - pandas
  - ai-agents
  - ai-tools
  - data-analysis
references:
  - type: dataset
    title: "Harpd AI Datasets"
    authors:
      - name: "Harpd"
        website: "https://harpd.com"
    year: 2026
    url: "https://harpd.com/data/"
    repository-code: "https://github.com/harpd-dev/harpd-ai-datasets"
    license: CC-BY-4.0
    notes: >-
      Product catalog, rank boards, category boards, discovery indexes and the
      evidence register. Published under CC BY 4.0.
  - type: dataset
    title: "Harpd LLM Cost Benchmark"
    authors:
      - name: "Harpd"
        website: "https://harpd.com"
    year: 2026
    url: "https://harpd.com/benchmarks/"
    repository-code: "https://github.com/harpd-dev/llm-cost-benchmark"
    license: MIT
    notes: >-
      Cost per successful task for JSON extraction. The published figures are a
      MODELED estimate derived from public list prices; notebook 07 labels them
      accordingly.
  - type: software
    title: "Harpd Model Replacement Benchmark"
    authors:
      - name: "Harpd"
        website: "https://harpd.com"
    year: 2026
    url: "https://harpd.com/methodology/model-replacement/"
    repository-code: "https://github.com/harpd-dev/model-replacement-benchmark"
    license: MIT
    notes: >-
      A comparison script with stubbed provider calls. It ships no result
      dataset, which is why notebook 06 reports the question as unanswerable
      rather than computing an answer.
